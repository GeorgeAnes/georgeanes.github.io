---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { sortProjects } from '../../lib/sort-projects';

const projects = sortProjects(await getCollection('projects'));

/*
 * The first project leads at full width; the rest sit in a two-column grid.
 * Cell count always matches project count, so the grid never carries a hole.
 */
const [lead, ...rest] = projects;
---

<BaseLayout
  title="Projects"
  description="Engineering and machine learning projects by George Anesiadis, spanning AI systems, control and robotics, optimization and industrial data science."
>
  <div class="mx-auto w-full max-w-5xl px-6 py-16">
    <header class="max-w-[58ch]">
      <h1 class="text-display font-semibold">Projects</h1>
      <p class="text-muted mt-5 text-lg">
        Work across AI systems, control and robotics, optimization and industrial data
        science. Each write-up covers the problem, the approach taken, and what the result
        does and does not show.
      </p>
    </header>

    {
      projects.length === 0 ? (
        <p class="text-muted mt-16 font-mono text-sm">No projects published yet.</p>
      ) : (
        <div class="mt-14 grid gap-6">
          {lead && <ProjectCard project={lead} size="lead" />}

          {rest.length > 0 && (
            <div class="grid gap-6 sm:grid-cols-2">
              {rest.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
</BaseLayout>
