---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>George Anesiadis</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-bg text-text">
    <main class="mx-auto max-w-2xl px-6 py-24">
      <h1 class="text-display font-semibold">George Anesiadis</h1>
      <p data-probe="muted" class="text-muted mt-3">
        Portfolio site, under construction.
      </p>
      <a
        href="#probe"
        data-probe="accent"
        class="text-accent border-border-strong rounded-md mt-6 inline-block border px-4 py-2"
        >Probe link</a
      >
    </main>
  </body>
</html>
