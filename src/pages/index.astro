---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { sortProjects } from '../lib/sort-projects';
import { SITE_NAME } from '../config/site';

const all = sortProjects(await getCollection('projects'));
const featured = all.filter((project) => project.data.featured);

/*
 * The strongest project carries the hero's visual, so the first thing a visitor
 * sees is real work rather than a decorative graphic. The other two featured
 * projects follow below.
 */
const [heroProject, ...restFeatured] = featured;

const focusAreas = [
  'Model predictive control, robotics and multi-agent systems',
  'Machine learning for sensor and vision data',
  'Optimization and decision-making algorithms',
  'AI engineering for technical and industrial workflows',
];
---

<BaseLayout
  title={SITE_NAME}
  description="MSc Artificial Intelligence and Engineering Systems student at TU/e, building AI systems for engineering: control, robotics, optimization and computer vision."
>
  {
    /*
     * Hero. Asymmetric rather than centred, and held to three text elements:
     * headline, one line of subtext, and the CTA pair. Everything else that
     * wants to be here (focus areas, contact) lives in its own section below.
     */
  }
  <section class="mx-auto w-full max-w-5xl px-6 pt-12 pb-20 lg:pt-16">
    <div
      class="grid items-start gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]"
    >
      <div>
        <h1 class="text-display font-semibold">George Anesiadis</h1>

        <p
          data-probe="muted"
          class="text-muted mt-5 max-w-[46ch] text-lg leading-relaxed"
        >
          MSc Artificial Intelligence and Engineering Systems at TU/e. I build AI systems
          for engineering problems.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/projects/"
            class="bg-accent text-on-accent rounded-md inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
            style="transition-duration: var(--duration-fast); transition-timing-function: var(--ease-out-quint)"
          >
            View projects
            <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a
            href="#contact"
            class="border-border-strong hover:border-accent hover:text-accent rounded-md inline-flex items-center border px-5 py-2.5 text-sm transition-colors"
            style="transition-duration: var(--duration-fast); transition-timing-function: var(--ease-out-quint)"
          >
            Get in touch
          </a>
        </div>
      </div>

      {heroProject && <ProjectCard project={heroProject} size="lead" />}
    </div>
  </section>

  {
    restFeatured.length > 0 && (
      <section class="mx-auto w-full max-w-5xl px-6 py-16">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="text-title font-semibold">Selected work</h2>
          <a
            href="/projects/"
            data-probe="accent"
            class="text-accent text-sm underline underline-offset-4"
          >
            All {all.length} projects
          </a>
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {restFeatured.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  {/* Prose plus a list: a different layout family from the two card sections. */}
  <section id="about" class="border-border mx-auto w-full max-w-5xl border-t px-6 py-16">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <h2 class="text-title font-semibold">About</h2>

      <div>
        <p class="text-muted leading-relaxed">
          I am an MSc student in Artificial Intelligence and Engineering Systems at
          Eindhoven University of Technology, on the High Tech Systems and Robotics track,
          with a background in Chemical Engineering. My work sits where machine learning
          meets engineering systems: control, robotics, optimization, computer vision and
          industrial data science.
        </p>
        <p class="text-muted mt-4 leading-relaxed">
          Most of the projects here started as research or coursework and were then
          rebuilt as public, reproducible versions. Each write-up states what the result
          shows and, where it matters, what it does not.
        </p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            focusAreas.map((area) => (
              <li class="text-muted flex gap-3 text-sm">
                <Icon
                  name="ph:arrow-right"
                  class="text-accent mt-1 size-4 shrink-0"
                  aria-hidden="true"
                />
                <span>{area}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    id="contact"
    class="border-border mx-auto w-full max-w-5xl border-t px-6 py-16"
  >
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <h2 class="text-title font-semibold">Contact</h2>
      <div>
        <p class="text-muted max-w-[52ch] leading-relaxed">
          Open to conversations about machine learning and AI engineering roles, and to
          questions about any of the work here.
        </p>
        <div class="mt-6">
          <ContactLinks layout="stacked" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
