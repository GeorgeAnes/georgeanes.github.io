---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHero from '../components/PortfolioHero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { sortProjects } from '../lib/sort-projects';
import { SITE_NAME } from '../config/site';
import { projectCovers } from '../config/project-covers';

const all = sortProjects(await getCollection('projects'));
const featured = all.filter((project) => project.data.featured);

const focusAreas = [
  'Model predictive control, robotics and multi-agent systems',
  'Machine learning for sensor and vision data',
  'Optimization and decision-making algorithms',
  'AI engineering for technical and industrial workflows',
];
---

<BaseLayout
  title={SITE_NAME}
  description="MSc Artificial Intelligence and Engineering Systems student at TU/e, building AI systems for engineering: control, robotics, optimization and computer vision."
  ogImage="/og/default.png"
>
  <PortfolioHero />

  {
    featured.length > 0 && (
      <section id="selected-work" class="site-shell selected-work">
        <div class="section-heading">
          <h2>Selected work</h2>
          <a
            href="/projects/"
            data-probe="accent"
            class="text-accent text-sm underline underline-offset-4"
          >
            All {all.length} projects
          </a>
        </div>

        <div class="work-mosaic">
          {featured.map((project) =>
            projectCovers[project.id] ? (
              <FeaturedProject project={project} cover={projectCovers[project.id]} />
            ) : (
              <ProjectCard project={project} />
            ),
          )}
        </div>
      </section>
    )
  }

  <section id="about" class="site-shell about-section">
    <p class="section-label">About</p>
    <div class="about-grid">
      <div class="about-copy">
        <h2>From engineering<br />systems to AI.</h2>
        <p>
          I am an MSc student in Artificial Intelligence and Engineering Systems at
          Eindhoven University of Technology, on the High Tech Systems and Robotics track,
          with a background in Chemical Engineering. My work sits where machine learning
          meets engineering systems: control, robotics, optimization, computer vision and
          industrial data science.
        </p>
        <p>
          Most of the projects here started as research or coursework and were then
          rebuilt as public, reproducible versions. Each write-up states what the result
          shows and, where it matters, what it does not.
        </p>
      </div>
      <div class="focus-areas">
        <h3>Areas I work in</h3>
        <ul>
          {focusAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <div class="site-shell contact-grid">
      <div>
        <p class="section-label">Contact</p>
        <h2>Let’s talk AI<br />and engineering.</h2>
      </div>
      <div class="contact-details">
        <p>
          Open to conversations about machine learning and AI engineering roles, and to
          questions about any of the work here.
        </p>
        <div class="mt-6">
          <ContactLinks layout="stacked" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .selected-work {
    padding-block: 1rem 6rem;
  }
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .section-heading h2 {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .section-label {
    color: var(--ui-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 1.5rem;
  }
  .about-section {
    padding-block: 4.5rem 6rem;
    border-top: 1px solid var(--ui-border);
  }
  .about-grid,
  .contact-grid {
    display: grid;
    gap: 3rem;
  }
  .about-copy h2,
  .contact-section h2 {
    font-size: clamp(2.1rem, 4vw, 3.5rem);
    line-height: 1.1;
    font-weight: 450;
    letter-spacing: -0.045em;
  }
  .about-copy p {
    max-width: 59ch;
    margin-top: 1.5rem;
    color: var(--ui-muted);
    line-height: 1.8;
  }
  .focus-areas {
    align-self: end;
  }
  .focus-areas h3 {
    font-size: 0.8125rem;
    color: var(--ui-muted);
    margin-bottom: 0.5rem;
  }
  .focus-areas li {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--ui-border);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .contact-section {
    border-top: 1px solid var(--ui-border);
    padding-block: 5rem;
    background: radial-gradient(
      ellipse at 0 100%,
      rgb(74 91 170 / 0.13),
      transparent 60%
    );
  }
  .contact-details {
    align-self: end;
  }
  .contact-details p {
    max-width: 43ch;
    color: var(--ui-muted);
    line-height: 1.8;
  }
  @media (min-width: 900px) {
    .about-grid,
    .contact-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 6rem;
    }
  }
  @media (max-width: 599px) {
    .selected-work {
      padding-bottom: 4rem;
    }
    .about-section {
      padding-block: 3rem 4rem;
    }
    .contact-section {
      padding-block: 3.5rem;
    }
  }
</style>
