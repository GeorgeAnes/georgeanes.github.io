---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, GITHUB_URL } from '../config/site';
---

<BaseLayout
  title={SITE_NAME}
  description="MSc Artificial Intelligence and Engineering Systems student at TU/e, building AI systems for engineering: control, robotics, optimization, computer vision and industrial data science."
>
  <section class="mx-auto w-full max-w-5xl px-6 py-24">
    <h1 class="text-display font-semibold">George Anesiadis</h1>
    <p data-probe="muted" class="text-muted mt-4 max-w-[55ch] text-lg">
      AI and engineering systems. Nine projects across control, robotics, optimization and
      machine learning are being written up here.
    </p>
    <p class="mt-8">
      <a
        data-probe="accent"
        href={GITHUB_URL}
        rel="noopener"
        class="text-accent font-mono text-sm underline underline-offset-4"
      >
        {GITHUB_URL.replace('https://', '')}
      </a>
    </p>
  </section>
</BaseLayout>
