---
import ThemeToggle from './ThemeToggle.astro';
/**
 * AC6: the blog stays out of primary navigation until a post exists. Derived
 * at build time rather than from a flag someone has to remember to flip.
 *
 * Deliberately a glob rather than getCollection: v1 ships the blog with zero
 * posts, and querying an empty collection makes Astro warn on every page it
 * renders. That warning would be permanent noise and would mask real ones.
 * "Does a post file exist" is a directory question, so ask the directory.
 */
const postModules = import.meta.glob<{ frontmatter?: { draft?: boolean } }>(
  '../content/posts/*.{md,mdx}',
  { eager: true },
);

const hasPublishedPost = Object.values(postModules).some(
  (post) => post.frontmatter?.draft !== true,
);

const links = [
  { label: 'Projects', href: '/projects/' },
  { label: 'About', href: '/#about' },
  ...(hasPublishedPost ? [{ label: 'Writing', href: '/blog/' }] : []),
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/#about' && path.startsWith(href);
---

{/* Single line at every width, 72px tall, under the 80px cap. */}
<header class="site-header">
  <nav aria-label="Primary" class="site-shell flex h-[72px] items-center gap-2 sm:gap-7">
    <a
      href="/"
      class="site-name hover:text-accent mr-auto font-medium tracking-tight transition-colors"
      style="transition-duration: var(--duration-fast); transition-timing-function: var(--ease-out-quint)"
    >
      George Anesiadis
    </a>

    <ul class="flex items-center gap-3 sm:gap-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'nav-link hover:text-accent transition-colors aria-[current=page]:text-accent',
                isCurrent(link.href) ? 'text-accent' : 'text-muted',
              ]}
              style="transition-duration: var(--duration-fast); transition-timing-function: var(--ease-out-quint)"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 3;
  }
  .site-name {
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .nav-link {
    font-size: 0.75rem;
    padding-block: 0.65rem;
  }
  .nav-link[aria-current='page'] {
    border-bottom: 1px solid currentColor;
  }
  @media (min-width: 640px) {
    .site-name {
      font-size: 0.9375rem;
    }
    .nav-link {
      font-size: 0.8125rem;
    }
  }
</style>
