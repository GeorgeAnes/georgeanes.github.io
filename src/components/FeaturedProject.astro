---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

interface Props {
  project: CollectionEntry<'projects'>;
  cover: { image: ImageMetadata; summary: string };
  headingLevel?: 2 | 3;
}
const { project, cover, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="featured-project">
  <div class="cover-scene" aria-hidden="true">
    <Picture
      src={cover.image}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 640, 960, 1200]}
      sizes="(min-width: 1200px) 620px, (min-width: 900px) 55vw, calc(100vw - 48px)"
      class="cover-image"
    />
  </div>
  <div class="cover-copy">
    <Heading>
      <a href={`/projects/${project.id}/`}>
        {project.data.title}
        <Icon name="ph:arrow-up-right" class="cover-arrow size-5" aria-hidden="true" />
      </a>
    </Heading>
    <p>{cover.summary}</p>
  </div>
</article>

<style>
  .featured-project {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: end;
    min-height: 21rem;
    overflow: hidden;
    border: 1px solid var(--ui-border);
    border-radius: var(--radius-lg);
    background: var(--ui-bg);
    transition:
      border-color 250ms,
      transform 450ms var(--ease-out-quint);
  }
  .featured-project:first-child {
    min-height: 30rem;
  }
  .cover-scene {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .cover-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 30%, rgb(5 11 25 / 0.18) 45%, #050b19 100%);
  }
  .cover-scene :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 800ms var(--ease-out-quint);
  }
  .cover-copy {
    width: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    color: #e2edfc;
  }
  h2,
  h3 {
    max-width: 22ch;
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }
  a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cover-arrow {
    display: inline-block;
    margin-left: 0.35rem;
    vertical-align: baseline;
    transition: transform 250ms;
  }
  p {
    max-width: 43ch;
    margin-top: 0.85rem;
    color: #b2c2d9;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .featured-project:focus-within {
    border-color: var(--ui-accent);
  }
  :global([data-theme='light']) .cover-scene::after {
    background: linear-gradient(transparent 15%, rgb(5 11 25 / 0.3) 45%, #050b19 100%);
  }
  @media (min-width: 900px) {
    .featured-project {
      min-height: 19rem;
    }
    .featured-project:first-child {
      min-height: 39.25rem;
    }
    .featured-project:first-child h2,
    .featured-project:first-child h3 {
      font-size: clamp(2rem, 3vw, 2.75rem);
    }
    .featured-project:first-child p {
      font-size: 1rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .featured-project {
        /* Keep the timeline separate after CSS optimization; see lightningcss#1283. */
        animation-name: cover-arrive;
        animation-duration: 1s;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .featured-project:hover {
        border-color: var(--ui-accent);
      }
      .featured-project:hover :global(img) {
        transform: scale(1.045);
      }
      .featured-project:hover .cover-arrow {
        transform: translate(2px, -2px);
      }
    }
  }
  @keyframes cover-arrive {
    from {
      translate: 0 14px;
      scale: 0.985;
    }
    to {
      translate: 0 0;
      scale: 1;
    }
  }
</style>
